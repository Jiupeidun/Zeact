{
  "name": "@kertin/zeact",
  "version": "0.1.0",
  "description": "Scenario-tuned performance primitives for React 18",
  "keywords": [
    "react",
    "react-hooks",
    "performance",
    "virtual-list",
    "realtime",
    "charts",
    "live-streaming",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js",
      "require": "./dist/chat/index.cjs"
    },
    "./trade": {
      "types": "./dist/trade/index.d.ts",
      "import": "./dist/trade/index.js",
      "require": "./dist/trade/index.cjs"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js",
      "require": "./dist/live/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:demo": "vite build --config examples/basic/vite.config.ts",
    "check:package": "node scripts/validate-package.mjs",
    "dev": "vite --config examples/basic/vite.config.ts",
    "preview:demo": "vite preview --config examples/basic/vite.config.ts",
    "prepack": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:package"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <19",
    "react-dom": ">=18.2.0 <19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://jiupeidun.github.io/Zeact/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiupeidun/Zeact.git"
  },
  "bugs": {
    "url": "https://github.com/Jiupeidun/Zeact/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.1",
      "bundle-require": {
        "esbuild": "0.28.1"
      }
    }
  },
  "license": "MIT"
}
